<Window x:Class="VideoPlayer.PostProcessingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="עיבוד תמונה וקול"
        Width="460" Height="400"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="60"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="בהירות:" VerticalAlignment="Center" Margin="0,0,8,12"/>
        <Slider x:Name="BrightnessSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="2"
                VerticalAlignment="Center" Margin="0,0,0,12"/>
        <TextBlock x:Name="BrightnessText" Grid.Row="0" Grid.Column="2" TextAlignment="Center"
                   VerticalAlignment="Center" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="ניגודיות:" VerticalAlignment="Center" Margin="0,0,8,12"/>
        <Slider x:Name="ContrastSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="2"
                VerticalAlignment="Center" Margin="0,0,0,12"/>
        <TextBlock x:Name="ContrastText" Grid.Row="1" Grid.Column="2" TextAlignment="Center"
                   VerticalAlignment="Center" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="רוויה:" VerticalAlignment="Center" Margin="0,0,8,12"/>
        <Slider x:Name="SaturationSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="3"
                VerticalAlignment="Center" Margin="0,0,0,12"/>
        <TextBlock x:Name="SaturationText" Grid.Row="2" Grid.Column="2" TextAlignment="Center"
                   VerticalAlignment="Center" Margin="0,0,0,12"/>

        <CheckBox x:Name="DeinterlaceCheck" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,0,0,10"
                  Content="ביטול שורות אופקיות בווידאו ישן (Deinterlace)" Click="Option_Click"/>
        <CheckBox x:Name="SharpenCheck" Grid.Row="4" Grid.ColumnSpan="3" Margin="0,0,0,10"
                  Content="חידוד תמונה (Sharpen)" Click="Option_Click"/>
        <CheckBox x:Name="NormalizeCheck" Grid.Row="5" Grid.ColumnSpan="3" Margin="0,0,0,10"
                  Content="איזון עוצמת שמע (מנמיך קולות חזקים ומגביר שקטים)" Click="Option_Click"/>

        <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Text="בהירות, ניגודיות ורוויה ו-Deinterlace מתעדכנים מיד. חידוד ואיזון שמע נכנסים לתוקף בפתיחה מחדש של הקובץ הנוכחי."
                   TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="אישור" Width="100" Height="30" IsDefault="True" Margin="0,0,10,0" Click="Ok_Click"/>
            <Button Content="ביטול" Width="100" Height="30" IsCancel="True" Margin="0,0,10,0"/>
            <Button Content="איפוס" Width="100" Height="30" Click="Reset_Click"/>
        </StackPanel>
    </Grid>
</Window>
