<Window x:Class="VideoPlayer.SubtitleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="עריכת כתוביות" Height="550" Width="800"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="הוסף שורה" Padding="10,3" Margin="0,0,6,0" Click="AddCue_Click"/>
            <Button Content="מחק שורה" Padding="10,3" Margin="0,0,6,0" Click="RemoveCue_Click"/>
            <TextBlock Text="הזז הכל (מילישניות):" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <TextBox x:Name="ShiftBox" Width="80" Text="0" VerticalContentAlignment="Center"/>
            <Button Content="החל הזזה" Padding="10,3" Margin="6,0,0,0" Click="Shift_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
            <Button Content="שמור" Width="100" Padding="8,4" Margin="0,0,6,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="ביטול" Width="100" Padding="8,4" IsCancel="True"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <DataGrid x:Name="CueGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="התחלה (00:00:01,500)" Binding="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                <DataGridTextColumn Header="סיום" Binding="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                <DataGridTextColumn Header="טקסט (⏎ = שורה חדשה)" Binding="{Binding DisplayText, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
