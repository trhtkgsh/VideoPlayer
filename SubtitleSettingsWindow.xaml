<Window x:Class="VideoPlayer.SubtitleSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="הגדרות כתוביות"
        Width="460" Height="430"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="גופן:" VerticalAlignment="Center" Margin="0,0,8,12"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="FontCombo" Margin="0,0,0,12"
                  DisplayMemberPath="Text" SelectedValuePath="Value"
                  SelectionChanged="FontCombo_SelectionChanged"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="גודל:" VerticalAlignment="Center" Margin="0,0,8,12"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SizeCombo" Margin="0,0,0,12"
                  DisplayMemberPath="Text" SelectedValuePath="Value"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="צבע:" VerticalAlignment="Center" Margin="0,0,8,12"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ColorCombo" Margin="0,0,0,12"
                  DisplayMemberPath="Text" SelectedValuePath="Value"
                  SelectionChanged="ColorCombo_SelectionChanged"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="קידוד:" VerticalAlignment="Center" Margin="0,0,8,12"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="EncodingCombo" Margin="0,0,0,12"
                  DisplayMemberPath="Text" SelectedValuePath="Value"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="תצוגה מקדימה:" Margin="0,0,0,6"/>
        <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Background="Black" CornerRadius="4"
                MinHeight="80" Padding="10" Margin="0,0,0,12">
            <TextBlock x:Name="PreviewText" Foreground="White" TextAlignment="Center"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="שלום עולם - זו דוגמה לכתובית בעברית 123"/>
        </Border>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="אישור" Width="100" Height="30" IsDefault="True" Margin="0,0,10,0" Click="Ok_Click"/>
            <Button Content="ביטול" Width="100" Height="30" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
